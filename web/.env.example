# ─── Mudbase project (public routing info - safe to expose to the browser) ───
# The project this app talks to. A project ID and a publishable (pk_) key are public routing
# values, not secrets - collection access is authorized by each end-user's bearer JWT.
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
NEXT_PUBLIC_MUDBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_MUDBASE_API_KEY=pk_your_publishable_key

# Collection IDs (create the two collections once, then paste their IDs here).
NEXT_PUBLIC_AUCTIONS_COLLECTION_ID=your_auctions_collection_id
NEXT_PUBLIC_BIDS_COLLECTION_ID=your_bids_collection_id

# Display currency for all drops (app-level choice; Mudbase collects card + mobile money).
NEXT_PUBLIC_CURRENCY=USD

# The application role end-users sign up as. Provisioned by scripts/provision.mjs; if your
# project uses a different default starter role, set that slug here instead.
NEXT_PUBLIC_APP_ROLE=bidder

# ─── Payment collection (SERVER-ONLY - never prefix with NEXT_PUBLIC_) ────────
# Scoped API key with `payment:create` + `data:read` permission. Used only inside the
# /api/checkout Route Handler to start collecting the winning bidder's payment. Keep it secret.
MUDBASE_PAYMENTS_API_KEY=ak_your_scoped_payments_key
